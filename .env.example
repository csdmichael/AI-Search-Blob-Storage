# ─────────────────────────────────────────────────────────────────────────────
# Azure AI Search – Blob Storage project configuration
#
# Copy this file to .env and fill in every value for your deployment.
# The .env file is ignored by git so secrets are never committed.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values, then run any script normally:
#   python scripts/upload_to_blob.py
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure Subscription / Resource Group ──────────────────────────────────────
# The subscription that hosts all resources below.
AZURE_SUBSCRIPTION_ID=

# The resource group that contains the storage account, search service, etc.
AZURE_RESOURCE_GROUP=

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Name of the Storage Account (must already exist).
AZURE_STORAGE_ACCOUNT_NAME=

# Blob container where engineering documents are stored.
# Default: engineering-docs
AZURE_STORAGE_CONTAINER_NAME=engineering-docs

# ── Azure AI Search ───────────────────────────────────────────────────────────
# Name of the Azure AI Search service (must already exist).
AZURE_SEARCH_SERVICE_NAME=

# Name of the primary search index created by create_search_index.py.
# Default: engineering-docs-index
AZURE_SEARCH_INDEX_NAME=engineering-docs-index

# Name of the section-chunked index created by chunk_and_index.py.
# Default: engineering-docs-chunked-index
AZURE_SEARCH_CHUNKED_INDEX_NAME=engineering-docs-chunked-index

# Name of the blob indexer (used by create_search_index.py).
# Default: engineering-docs-indexer
AZURE_SEARCH_INDEXER_NAME=engineering-docs-indexer

# Name of the blob data source connection in AI Search.
# Default: engineering-docs-blob-datasource
AZURE_SEARCH_DATA_SOURCE_NAME=engineering-docs-blob-datasource

# ── Azure AI Foundry ──────────────────────────────────────────────────────────
# Full endpoint URL of your AI Foundry project.
# Format: https://<hub-name>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_PROJECT_ENDPOINT=

# Name of the AI Search connection registered inside the Foundry project.
# Find this in Azure AI Foundry → your project → Settings → Connected resources.
AZURE_AI_SEARCH_CONNECTION_NAME=

# ── Foundry Agent ─────────────────────────────────────────────────────────────
# Display name for the Foundry agent created by create_agent.py.
# Default: Eng-Docs-Search-Agent
AGENT_NAME=Eng-Docs-Search-Agent

# Name of the deployed chat model used by the agent.
# Default: gpt-4.1
MODEL_DEPLOYMENT_NAME=gpt-4.1

# Base model used for fine-tuning (fine_tune_and_evaluate.py).
# Default: gpt-4.1
FINE_TUNE_BASE_MODEL=gpt-4.1

# ── GitHub Actions (CI/CD) ────────────────────────────────────────────────────
# The variables below are only needed when running via GitHub Actions.
# Set them as repository secrets (Settings → Secrets and variables → Actions).
#
# AZURE_CLIENT_ID     – Service principal / managed identity client ID
# AZURE_TENANT_ID     – Azure AD tenant ID
